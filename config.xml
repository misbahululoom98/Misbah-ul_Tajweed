<?xml version='1.0' encoding='utf-8'?>
<widget id="com.noor.tajweed" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <name>Noor-ut-Tajweed</name>
    <description>
        Noor-ut-Tajweed: Interactive Tajweed learning app (Urdu) — lessons, interactive articulation-point map, quiz and stats.
    </description>
    <author email="you@example.com" href="https://example.com">
        Tajweed App
    </author>
    <content src="index.html" />

    <!-- Allow the app to load its CDN dependencies (Tailwind, Chart.js, Google Fonts) -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xfff8fafc" />

    <platform name="android">
        <!-- Internet permission is added automatically by cordova-android, but declared here for clarity -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>
        <allow-intent href="market:*" />
    </platform>

    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
</widget>
